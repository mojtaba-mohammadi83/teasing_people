<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f5f2ec">
  <title>پرونده مجتبی 💜</title>

  <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600;700;800&display=swap" rel="stylesheet">

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      padding: 20px;
      display: grid;
      place-items: center;
      background: #f5f2ec;
      color: #252329;
      font-family: Vazirmatn, sans-serif;
    }

    .card {
      width: 100%;
      max-width: 360px;
      padding: 25px 22px;
      background: #fff;
      border: 1px solid #252329;
      border-radius: 18px;
      text-align: center;
      box-shadow: 4px 4px 0 #252329;
    }

    .tag {
      font-size: 11px;
      color: #777;
    }

    .emoji {
      font-size: 35px;
      margin: 24px 0 12px;
    }

    h1 {
      font-size: 21px;
      line-height: 1.9;
      margin: 8px 0;
    }

    p {
      font-size: 13px;
      line-height: 2.2;
      color: #69656e;
    }

    button {
      font: 600 12px Vazirmatn, sans-serif;
      cursor: pointer;
      padding: 10px 13px;
      border: 1px solid #252329;
      border-radius: 9px;
      background: white;
      color: #252329;
      transition: transform .2s, background .2s;
    }

    button:hover {
      transform: translateY(-2px);
    }

    button:focus-visible,
    input:focus-visible {
      outline: 2px solid #9875d5;
      outline-offset: 3px;
    }

    button:disabled {
      cursor: wait;
      opacity: .65;
    }

    .primary {
      background: #e7dcff;
    }

    .buttons {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 20px;
    }

    .reply {
      margin-top: 16px;
      padding: 12px;
      background: #f5f0ff;
      border-radius: 10px;
      font-size: 12px;
      line-height: 2;
      overflow-wrap: anywhere;
    }

    .send-status {
      margin-top: 9px;
      font-size: 11px;
      line-height: 1.9;
      color: #777;
      overflow-wrap: anywhere;
    }

    .hidden {
      display: none !important;
    }

    input {
      width: 100%;
      margin-top: 12px;
      padding: 11px;
      border: 1px solid #252329;
      border-radius: 9px;
      font: 13px Vazirmatn, sans-serif;
      text-align: right;
      background: #fff;
      color: #252329;
    }

    .footer {
      font-size: 10px;
      color: #999;
      margin-top: 25px;
    }

    @media (max-width: 400px) {
      body {
        padding: 14px;
      }

      .card {
        padding: 22px 17px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      button {
        transition: none;
      }
    }
  </style>
</head>

<body>
  <main class="card">

    <div class="tag">پرونده ۰۰۱ — دادگاه دلخوری‌ها</div>

    <section id="start">
      <div class="emoji">⚖️</div>

      <h1>دختر بهسوددد،<br>مجتبی یه غلطی کرده انگار 😭</h1>

      <p>
        متهم به ناراحت کردن یه عدد دختر لجباز.<br>
        انگیزه: معلوم نیس والا<br>
        وضعیت متهم: پشیمون ولی هنوز یه کم پررو 😔
      </p>

      <div class="buttons">
        <button class="primary" onclick="go('quiz')">
          بازجویی کن ببینم 😭
        </button>
      </div>
    </section>

    <section id="quiz" class="hidden">
      <div class="emoji" id="emoji">😏</div>
      <h1 id="title"></h1>
      <p id="desc"></p>

      <div class="buttons" id="options"></div>

      <div id="reply" class="reply hidden" aria-live="polite"></div>
      <div id="sendStatus" class="send-status hidden" aria-live="polite"></div>

      <div class="buttons hidden" id="next">
        <button class="primary" onclick="advance()">
          بعدی خانم قاضی ←
        </button>
      </div>
    </section>

    <section id="tea" class="hidden">
      <div class="emoji">☕</div>

      <h1>حالا یه پیشنهاد دارم 😔💜</h1>

      <p>
        بیا یه چایی با من بخور دیگه.<br>
        دختر بهسود قول میدم این دفعه کمتر حرف بزنم بیشتر گوش بدم.<br>
        قول میدم پسر خوبی باشم، برات گل بگیرم، چای هم به حساب من 😭
      </p>

      <div class="buttons" id="teaButtons">
        <button class="primary" onclick="go('date')">
          باشه ببینم چی میگی 😏
        </button>

        <button onclick="decline()">
          نه هنوز اعصابم ازت خورده 😒
        </button>
      </div>

      <div id="teaReply" class="reply hidden" aria-live="polite"></div>

      <div class="buttons hidden" id="laterBtn">
        <button onclick="go('later')">
          فعلا برو به کارت برس
        </button>
      </div>
    </section>

    <section id="date" class="hidden">
      <div class="emoji">🗓️</div>

      <h1>ینی قاضی رضایت داد؟ 😭</h1>

      <p>
        خب حالا بگو کی ببینمت خانم محترم؟ 😌<br>
        فقط نگی هر وقت قسمت شد یا اصلا نمیخوام ببینمت که من سکته میکنم
      </p>

      <form id="dateForm">
        <input id="when" type="text" maxlength="200" placeholder="مثلا پنجشنبه ساعت ۵" autocomplete="off"
          aria-label="زمان پیشنهادی قرار">

        <div class="buttons">
          <button class="primary" id="saveDateBtn" type="submit">
            ثبت قرار با متهم ☕
          </button>
        </div>
      </form>

      <div id="dateReply" class="reply hidden" aria-live="polite"></div>
      <div id="dateSendStatus" class="send-status hidden" aria-live="polite"></div>

      <div class="buttons hidden" id="copyBtn">
        <button id="copyDateBtn" type="button">
          کپی پیشنهاد 📋
        </button>
      </div>
    </section>

    <section id="later" class="hidden">
      <div class="emoji">🥹</div>

      <h1>چشم خانوم قاضی 😔💜</h1>

      <p>
        باشه دیگه اصرار نمیکنم.<br>
        هر وقت دلت خواست خودت میدونی کجا پیدام کنی.<br><br>
        فقط یه چیزی بین خودمون بمونه.<br>
        این متهمه هنوز یه کوچولو امید داره ها 😏
      </p>
    </section>

    <div class="footer">
      مجتبی × دختر بهسود · پرونده هنوز بسته نشده 💜
    </div>

    <script>
      const $ = id => document.getElementById(id);

      // ایمیل مقصد پاسخ‌ها
      const ANSWERS_EMAIL = "mojtabamainmal1010@gmail.com";

      // ارسال پاسخ از طریق FormSubmit
      async function sendAnswer(question, answer) {
        const statusMessage = {
          success: false,
          message: ""
        };

        try {
          const response = await fetch(
            "https://formsubmit.co/ajax/" + ANSWERS_EMAIL,
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                "Accept": "application/json"
              },
              body: JSON.stringify({
                _subject: "💜 پرونده مجتبی — پاسخ جدید",
                Question: question,
                "Her answer": answer,
                _template: "table"
              })
            }
          );

          const result = await response.json();

          console.log("FormSubmit HTTP status:", response.status);
          console.log("FormSubmit response:", result);

          if (!response.ok ||
            result.success !== true &&
            result.success !== "true") {
            throw new Error(
              result.message || JSON.stringify(result)
            );
          }

          return {
            success: true,
            message: "پاسخ برای ارسال پذیرفته شد 💜"
          };

        } catch (error) {
          console.error("Email sending failed:", error);

          return {
            success: false,
            message: "ارسال ناموفق بود: " + error.message
          };
        }
      }

      // نمایش بخش انتخاب‌شده
      function go(id) {
        document.querySelectorAll("main section").forEach(section => {
          section.classList.add("hidden");
        });

        $(id).classList.remove("hidden");
      }

      const questions = [
        {
          e: "😏",
          t: "هنوز ازم عصبانی‌ای؟",
          d: "راستشو بگو دیگه، وکیل ندارم از خودم دفاع کنم 😭",
          a: [
            [
              "آره خیلی 😒",
              "اخه میدونم حق داری ازم ناراحت باشی 🥲 ولی منم اومدم نازت و بکشم دیگه، انقد اخم نکن موهات سفید میشه 💜"
            ],
            [
              "یه کم فقط 🙄",
              "یه کم یعنی هنوز امیدی هست؟ 😭 یکی بیاد این لحظه تاریخی رو ثبت کنه، خانوم قاضی داره نرم میشه"
            ],
            [
              "به تو چه 😏",
              "به من چه؟ باشه اصن هیچی، فقط این لبخند الکی رو لبم واسه چیه پس؟ خودت بگو خانوم باهوش 😌"
            ]
          ]
        },
        {
          e: "🔨",
          t: "خب حکمت چیه خانوم؟",
          d: "فقط یه جوری حکم نده که دیگه نتونم نازت و بکشم 😭",
          a: [
            [
              "اول معذرت خواهی کن",
              "ببخش دیگه اگه ناراحتت کردم 🥺 نمیخوام فقط بگم ببخشید که رد شی، میخوام حواسم بیشتر بهت باشه. حالا یکم خوش اخلاق تر شو   😔💜"
            ],
            [
              "خودتو درست کن",
              "چشممم فقط یه دفترچه راهنما هم بده دستم، اینجانب یه کم دیر یاد میگیرم ولی قول میدم تلاشمو بکنم 😭🤝"
            ],
            [
              "فعلا برو گمشو 😒",
              "چشم دیگه میرم کنار تا آروم شی، ولی بدون این اخمات خیلی جدیه ها خانوم قاضی 😭💜"
            ]
          ]
        },
        {
          e: "🥹",
          t: "یه چیزی بپرسم ازت؟",
          d: "قول بده بعدش نگی مجتبی باز شروع کرد",
          a: [
            [
              "بپرس ببینم 😏",
              "دلت یه ذره واسم تنگ نشده؟ 😭 فقط یه ذره ها، نمیخوام الان اعتراف تاریخی بگیریم ازت."
            ],
            [
              "نه اصلا",
              "آره معلومه منم اصن اصن بهت فکر نمیکنم، فقط نمیدونم چرا هی دارم باهات حرف میزنم الان 😔😏"
            ],
            [
              "شاید یکم 🫣",
              "یااا خدااا یکی بیاد منو جمع کنه، همین یه کلمه رو گفتی تا آخر هفته باهاش خوشم 😭💜"
            ]
          ]
        },
        {
          e: "💜",
          t: "حالا یه اعتراف کوچولو؟",
          d: "این قسمت پرونده محرمانه‌س، جایی نگی ها",
          a: [
            [
              "بگو دیگه",
              "من بعضی وقتا نمیدونم چجوری نازت و بکشم، بعد میام یه چیزی میگم خرابترش میکنم 😭 ولی خب چیکار کنم، دلم میخواد باهات خوب باشم."
            ],
            [
              "باز چیکار کردی؟ 😒",
              "هیچی بابااا چرا تا من میگم اعتراف، سریع سابقه کیفریمو میاری وسط؟ یه بارم بذار با آبرو زندگی کنم 😭"
            ],
            [
              "نمیخوام بشنوم 😏",
              "باشه نشنو فقط بعدا نیا بگی چرا نگفتی. منم خیلی مظلومانه سکوت میکنم الان 😔🤚"
            ]
          ]
        }
      ];


      let step = 0;
      let chosen = "";
      let refusals = 0;

      // ساخت پرسش فعلی
      function render() {
        const q = questions[step];

        $("emoji").textContent = q.e;
        $("title").textContent = q.t;
        $("desc").textContent = q.d;

        $("reply").classList.add("hidden");
        $("sendStatus").classList.add("hidden");
        $("next").classList.add("hidden");
        $("options").classList.remove("hidden");
        $("options").replaceChildren();

        q.a.forEach((answer, index) => {
          const button = document.createElement("button");

          button.type = "button";
          button.textContent = answer[0];

          if (index === 0) {
            button.classList.add("primary");
          }

          button.addEventListener("click", () => answerQuestion(index));

          $("options").appendChild(button);
        });
      }

      // ثبت پاسخ و نمایش جواب مخصوص آن
      async function answerQuestion(index) {
        const q = questions[step];
        const selectedAnswer = q.a[index][0];

        $("reply").textContent = q.a[index][1];
        $("reply").classList.remove("hidden");

        $("options").classList.add("hidden");
        $("next").classList.remove("hidden");

        $("next").querySelector("button").textContent =
          step === questions.length - 1
            ? "بریم سراغ پیشنهاد صلح؟ ☕"
            : "خب بعدی رو بپرس ببینم ←";

        $("sendStatus").textContent = "در حال ارسال پاسخ... ⏳";
        $("sendStatus").classList.remove("hidden");

        const result = await sendAnswer(q.t, selectedAnswer);

        $("sendStatus").textContent = result.message;
      }

      // رفتن به سؤال بعدی
      function advance() {
        step++;

        if (step >= questions.length) {
          go("tea");
          return;
        }

        render();
      }

      // پاسخ‌های مربوط به رد کردن پیشنهاد چای
      function decline() {
        refusals++;

        const messages = [
          "اخه ببین با چه مظلومیتی اومدم پیشنهاد چایی دادم، بازم رد شدم 😭 باشه خانوم، حق داری.",
          "باشه بابااا چایی فعلا کنسل، ولی این همه اخم واسه یه متهم بیچاره انصافه؟ 🥲",
          "چشم عزیزم، اصرار نمیکنم 💜 هر وقت خودت خواستی. فقط من الان باید برم یه گوشه به تصمیمات زندگیم فکر کنم."
        ];

        $("teaReply").textContent =
          messages[(refusals - 1) % messages.length];

        $("teaReply").classList.remove("hidden");
        $("laterBtn").classList.remove("hidden");
      }

      // ثبت پیشنهاد قرار
      $("dateForm").addEventListener("submit", async function (event) {
        event.preventDefault();

        chosen = $("when").value.trim();

        $("dateReply").classList.remove("hidden");
        $("dateSendStatus").classList.add("hidden");

        if (!chosen) {
          $("dateReply").textContent =
            "اول بگو کی ببینمت دیگه خانوم، نکنه میخوای من تا ابد منتظر بمونم؟ 😭";

          $("copyBtn").classList.add("hidden");
          return;
        }

        $("dateReply").textContent =
          "پیشنهادت ثبت شد: " + chosen +
          " ☕ حالا ببینیم قسمت میشه یا بازم باید بیام دادگاه! 💜";

        $("copyBtn").classList.remove("hidden");

        $("saveDateBtn").disabled = true;
        $("saveDateBtn").textContent = "در حال ارسال...";

        $("dateSendStatus").textContent =
          "در حال ارسال پیشنهاد قرار به ایمیل... ⏳";

        $("dateSendStatus").classList.remove("hidden");

        const result = await sendAnswer(
          "پیشنهاد قرار چایی",
          chosen
        );

        $("dateSendStatus").textContent = result.success
          ? "ارسال توسط سرویس تأیید شد؛ صندوق ورودی را بررسی کن 💜"
          : result.message;

        $("saveDateBtn").disabled = false;
        $("saveDateBtn").textContent = "ثبت قرار با متهم ☕";
      });

      // کپی کردن پیشنهاد قرار
      async function copyDate() {
        if (!chosen) {
          $("dateSendStatus").textContent =
            "اول زمان قرار رو وارد کن خانوم قاضی 😭";

          $("dateSendStatus").classList.remove("hidden");
          return;
        }

        const text =
          "پیشنهاد قرار چایی با مجتبی ☕\n" +
          "زمان پیشنهادی: " + chosen +
          "\nپرونده مجتبی 💜";

        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
          } else {
            const textarea = document.createElement("textarea");

            textarea.value = text;
            textarea.style.position = "fixed";
            textarea.style.opacity = "0";

            document.body.appendChild(textarea);
            textarea.focus();
            textarea.select();

            const copied = document.execCommand("copy");
            textarea.remove();

            if (!copied) {
              throw new Error("Copy command failed");
            }
          }

          $("dateSendStatus").textContent =
            "متن قرار کپی شد! حالا برام بفرستش خانوم قاضی 💜";

          $("dateSendStatus").classList.remove("hidden");

        } catch (error) {
          console.error("Copy failed:", error);

          $("dateSendStatus").textContent =
            "کپی خودکار انجام نشد؛ زمان قرار رو دستی کپی کن: " + chosen;

          $("dateSendStatus").classList.remove("hidden");
        }
      }

      $("copyDateBtn").addEventListener("click", copyDate);

      // نمایش اولین سؤال هنگام شروع
      render();
    </script>

  </main>
</body>

</html>
